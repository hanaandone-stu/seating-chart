function getSelectedObjects(){
 const ids=new Set(selectedIds);if(selected)ids.add(selected);
 return items.filter(o=>ids.has(o.id));
}
function setSelection(ids,activeId=null,anchorId=null){
 selectedIds=new Set(ids);
 selected=activeId&&selectedIds.has(activeId)?activeId:([...selectedIds].pop()||null);
 selectionAnchorId=anchorId||selectionAnchorId||selected;
 render();
 $('status').textContent=`已選取 ${selectedIds.size} 個物件`;
}
function selectableObjects(){
 return items.filter(o=>o.type!=='blockBounds').sort((a,b)=>(a.y+a.h/2)-(b.y+b.h/2)||(a.x+a.w/2)-(b.x+b.w/2));
}
function selectSeatLine(axis){
 // 以目前「作用中的物件 selected」作為定位依據，不能從多選集合任意抓第一個座位。
 // 否則之前多選過的座位會被誤當成這次點選的位置，造成整排／整欄偏移。
 let active=items.find(o=>o.id===selected&&o.type==='seat');
 if(!active){
  const selectedSeats=items.filter(o=>selectedIds.has(o.id)&&o.type==='seat');
  if(selectedSeats.length===1)active=selectedSeats[0];
 }
 if(!active||!active.groupId){
  $('status').textContent='請先單獨點選要作為定位基準的座位，再使用「選取整排／整欄」。';
  return;
 }
 const groupSeats=items.filter(o=>o.type==='seat'&&o.groupId===active.groupId);
 const track=axis==='row'?active.y:active.x;
 // 座位建立時每格的位置可能有間距，使用同一個實際座標列／欄比對，不使用最近格子或選取框座標。
 const seats=groupSeats.filter(o=>Math.abs((axis==='row'?o.y:o.x)-track)<1);
 if(!seats.length){
  $('status').textContent='找不到與目前座位同列／同欄的其他座位。';
  return;
 }
 snapshot();
 selectedIds=new Set(seats.map(o=>o.id));
 selected=active.id;
 selectionAnchorId=active.id;
 keyboardSeatRange=null;
 // 選取框直接使用該列／欄座位的實際物件邊界。
 const minX=Math.min(...seats.map(o=>o.x));
 const minY=Math.min(...seats.map(o=>o.y));
 const maxX=Math.max(...seats.map(o=>o.x+o.w));
 const maxY=Math.max(...seats.map(o=>o.y+o.h));
 selectedCellRange={x:minX,y:minY,w:maxX-minX,h:maxY-minY};
 selectedCell={x:active.x,y:active.y};
 hoverCell=null;
 render();
 $('status').textContent=`已選取整${axis==='row'?'排':'欄'}｜共 ${seats.length} 個座位`;
}

const selectRowButton=$('selectSeatRow');
const selectColumnButton=$('selectSeatColumn');
if(selectRowButton)selectRowButton.addEventListener('click',()=>selectSeatLine('row'));
if(selectColumnButton)selectColumnButton.addEventListener('click',()=>selectSeatLine('column'));

function keyboardSelectSeatRange(key){
 const active=items.find(o=>o.id===selected)||items.find(o=>selectedIds.has(o.id));
 if(!active)return false;
 const isRowLabel=active.type==='rowlabel';
 if(!['seat','rowlabel'].includes(active.type)||!active.groupId)return false;
 const allowedType=isRowLabel?'rowlabel':'seat';

 // 排數文字的可視範圍在物件原點左側（x - w 到 x），
 // 因此排數文字的鍵盤選取只用 Y 軸定位，不能共用座位格的 XY 格線框。
 if(isRowLabel){
  if(!keyboardSeatRange||keyboardSeatRange.groupId!==active.groupId||keyboardSeatRange.type!=='rowlabel'){
   keyboardSeatRange={groupId:active.groupId,type:'rowlabel',anchorY:active.y,cursorY:active.y};
  }
  if(key==='ArrowUp')keyboardSeatRange.cursorY=Math.max(0,keyboardSeatRange.cursorY-GRID);
  if(key==='ArrowDown')keyboardSeatRange.cursorY+=GRID;
  const y1=Math.min(keyboardSeatRange.anchorY,keyboardSeatRange.cursorY);
  const y2=Math.max(keyboardSeatRange.anchorY,keyboardSeatRange.cursorY);
  const labels=items.filter(o=>o.type==='rowlabel'&&o.groupId===active.groupId&&
   o.y>=y1-2&&o.y<=y2+2);
  selectedIds=new Set(labels.map(o=>o.id));
  selected=labels.find(o=>Math.abs(o.y-keyboardSeatRange.cursorY)<=2)?.id||active.id;
  selectionAnchorId=labels.find(o=>Math.abs(o.y-keyboardSeatRange.anchorY)<=2)?.id||active.id;
  // 排數文字不使用格子範圍標記，避免標記落在右側相鄰座位欄。
  selectedCellRange=null;
  selectedCell=null;
  hoverCell=null;
  render();
  $('status').textContent=`已選取 ${selectedIds.size} 個排數文字`;
  return true;
 }

 if(!keyboardSeatRange||keyboardSeatRange.groupId!==active.groupId||keyboardSeatRange.type!=='seat'){
  keyboardSeatRange={groupId:active.groupId,type:'seat',anchor:{x:snap(active.x),y:snap(active.y)},cursor:{x:snap(active.x),y:snap(active.y)}};
 }
 const step=key==='ArrowLeft'?{x:-GRID,y:0}:key==='ArrowRight'?{x:GRID,y:0}:key==='ArrowUp'?{x:0,y:-GRID}:{x:0,y:GRID};
 keyboardSeatRange.cursor={x:Math.max(0,keyboardSeatRange.cursor.x+step.x),y:Math.max(0,keyboardSeatRange.cursor.y+step.y)};
 const a=keyboardSeatRange.anchor,c=keyboardSeatRange.cursor;
 const x1=Math.min(a.x,c.x),y1=Math.min(a.y,c.y),x2=Math.max(a.x,c.x),y2=Math.max(a.y,c.y);
 const seats=items.filter(o=>o.type==='seat'&&o.groupId===active.groupId&&
  o.x>=x1-2&&o.x<=x2+2&&o.y>=y1-2&&o.y<=y2+2);
 selectedCellRange={x:x1,y:y1,w:x2-x1+GRID,h:y2-y1+GRID};
 selectedCell={x:c.x,y:c.y};
 selectedIds=new Set(seats.map(o=>o.id));
 selected=seats.find(o=>o.x===c.x&&o.y===c.y)?.id||active.id;
 selectionAnchorId=seats.find(o=>o.x===a.x&&o.y===a.y)?.id||active.id;
 render();
 $('status').textContent=`已選取 ${selectedIds.size} 個座位｜${selectedCellRange.w/GRID} 欄 × ${selectedCellRange.h/GRID} 列`;
 return true;
}

function keyboardMoveSelection(key,extend,wholeRun){
 const objects=selectableObjects();
 if(!objects.length)return false;
 const active=objects.find(o=>o.id===selected)||objects.find(o=>selectedIds.has(o.id));
 if(!active)return false;
 const anchor=objects.find(o=>o.id===(selectionAnchorId||active.id))||active;
 const horizontal=key==='ArrowLeft'||key==='ArrowRight';
 const sign=(key==='ArrowRight'||key==='ArrowDown')?1:-1;
 const axis=o=>horizontal?o.x+o.w/2:o.y+o.h/2;
 const crossStart=o=>horizontal?o.y:o.x;
 const crossEnd=o=>horizontal?o.y+o.h:o.x+o.w;
 const origin=active;
 let candidates=[];
 let sameTrack;

 // 排數文字的鍵盤移動／延伸只能在同一座位區的排數文字之間進行，絕不納入座位。
 if(active.type==='rowlabel'&&active.groupId){
  sameTrack=o=>o.type==='rowlabel'&&o.groupId===active.groupId&&
   (horizontal?Math.abs(o.y-active.y)<=3:true);
  candidates=objects.filter(o=>o.id!==active.id&&sameTrack(o)&&
   (axis(o)-axis(active))*sign>2)
   .sort((a,b)=>Math.abs(axis(a)-axis(active))-Math.abs(axis(b)-axis(active)));
 }else if(active.type==='seat'&&active.groupId){
  const rowRef=extend&&anchor.type==='seat'&&anchor.groupId===active.groupId?anchor:active;
  const trackValue=horizontal?rowRef.y:rowRef.x;
  sameTrack=o=>o.type==='seat'&&o.groupId===active.groupId&&
   Math.abs((horizontal?o.y:o.x)-trackValue)<=3;
  candidates=objects.filter(o=>o.id!==active.id&&sameTrack(o)&&
   (axis(o)-axis(active))*sign>2)
   .sort((a,b)=>Math.abs(axis(a)-axis(active))-Math.abs(axis(b)-axis(active)));
 }else{
  const trackTolerance=3;
  sameTrack=o=>{
   const overlap=Math.min(crossEnd(origin),crossEnd(o))-Math.max(crossStart(origin),crossStart(o));
   return overlap>trackTolerance ||
    Math.abs((crossStart(origin)+crossEnd(origin))/2-(crossStart(o)+crossEnd(o))/2)<=trackTolerance;
  };
  candidates=objects.filter(o=>o.id!==origin.id&&sameTrack(o)&&
   (axis(o)-axis(origin))*sign>2)
   .sort((a,b)=>Math.abs(axis(a)-axis(origin))-Math.abs(axis(b)-axis(origin)));
 }
 if(!candidates.length)return true;
 const target=wholeRun?candidates[candidates.length-1]:candidates[0];
 if(!extend){
  setSelection([target.id],target.id,target.id);
  return true;
 }
 const rangeAnchor=anchor;
 const low=Math.min(axis(rangeAnchor),axis(target));
 const high=Math.max(axis(rangeAnchor),axis(target));
 const picked=objects.filter(o=>sameTrack(o)&&axis(o)>=low-2&&axis(o)<=high+2);
 setSelection(picked.map(o=>o.id),target.id,rangeAnchor.id);
 return true;
}
function copySelection(cut=false){
