  snapshot();
  const ids=new Set(chosen.map(o=>o.id));
  const groups=new Set(chosen.filter(o=>o.type==='blockBounds'&&o.groupId).map(o=>o.groupId));
  items=items.filter(o=>!ids.has(o.id)&&!(o.groupId&&groups.has(o.groupId)));
  selected=null;selectedIds.clear();selectionAnchorId=null;render();
  $('status').textContent=`已剪下 ${chosen.length} 個物件`;
