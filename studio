async function exportPng(){
 const title=$('pngTitle').value.trim()||'座位表';
 const watermark='@hanaandone.stu';
 const opacity=Math.max(0.05,Math.min(.5,Number($('pngWatermarkOpacity').value)/100));
 const cloneSvg=svg.cloneNode(true);
 cloneSvg.querySelectorAll('.resize-handle,.selection-box,.cell-marker,.selection-marker').forEach(n=>n.remove());
 // blockBounds 僅供編輯選取，正式 PNG 不輸出虛線框
 cloneSvg.querySelectorAll('.object').forEach(n=>{const item=items.find(o=>o.id===n.getAttribute('data-id'));if(item?.type==='blockBounds')n.remove()});
 cloneSvg.querySelectorAll('.object').forEach(n=>n.classList.remove('selected'));
 cloneSvg.setAttribute('xmlns',NS);cloneSvg.setAttribute('width',canvasW);cloneSvg.setAttribute('height',canvasH);
 cloneSvg.setAttribute('viewBox',`0 0 ${canvasW} ${canvasH}`);
 const svgText=new XMLSerializer().serializeToString(cloneSvg);
 const blob=new Blob([svgText],{type:'image/svg+xml;charset=utf-8'});
 const url=URL.createObjectURL(blob);
 const image=new Image();
 image.onload=()=>{
  const scale=2,titleH=title?100:24;
  const canvas=document.createElement('canvas');
  canvas.width=canvasW*scale;canvas.height=(canvasH+titleH)*scale;
  const ctx=canvas.getContext('2d');
  ctx.fillStyle='#ffffff';ctx.fillRect(0,0,canvas.width,canvas.height);
  if(title){
   ctx.fillStyle='#24384d';ctx.textAlign='center';ctx.textBaseline='middle';
   ctx.font=`bold ${30*scale}px "Noto Sans TC", "Microsoft JhengHei", sans-serif`;
   ctx.fillText(title,canvas.width/2,50*scale,canvas.width-80*scale);
  }
  ctx.drawImage(image,0,titleH*scale,canvasW*scale,canvasH*scale);
  if(watermark){
   ctx.save();ctx.globalAlpha=opacity;ctx.fillStyle='#26384a';ctx.textAlign='center';ctx.textBaseline='middle';
   // 字體縮小，並依照實際文字寬度計算水平間距，避免長文字彼此重疊。
   const watermarkFontSize=Math.max(16,canvasW/52);
   ctx.font=`bold ${watermarkFontSize*scale}px "Noto Sans TC", "Microsoft JhengHei", sans-serif`;
   const textWidth=ctx.measureText(watermark).width;
   ctx.translate(canvas.width/2,canvas.height/2);ctx.rotate(-Math.PI/6);
   // 縮短列距以增加浮水印排數；每列交錯排列，維持均勻覆蓋。
   const stepX=(textWidth+watermarkFontSize*1.25*scale);
   const stepY=watermarkFontSize*3.35*scale;
   let row=0;
   for(let y=-canvas.height*1.5;y<canvas.height*1.5;y+=stepY){
    const offset=(row%2)*stepX/2;
    for(let x=-canvas.width*1.5-stepX;x<canvas.width*1.5+stepX;x+=stepX)ctx.fillText(watermark,x+offset,y);
    row++;
   }
   ctx.restore();
  }
  canvas.toBlob(png=>{if(png)download(png,'座位表.png');else alert('PNG 匯出失敗，請再試一次。');URL.revokeObjectURL(url)},'image/png');
 };
 image.onerror=()=>{URL.revokeObjectURL(url);alert('無法產生 PNG，請檢查圖面內容後再試一次。')};
 image.src=url;
}
