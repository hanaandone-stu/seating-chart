};
function applyCanvasGridChange(mode){
 const count=Math.max(1,Math.min(30,Math.floor(Number($('insertCount').value)||1)));
 const dir=$('insertDirection').value;
 const type=$('insertType')?.value||'column';
 if(!selectedCell){alert('請先點選畫布上的任意格子，或用方向鍵移動橘色格子游標。');return}
 if(mode==='insert'&&type==='cell'){
  const horizontal=dir==='left'||dir==='right';
  const axis=horizontal?'x':'y';
  const cross=horizontal?'y':'x';
  const threshold=selectedCell[axis];
  const bandStart=selectedCell[cross],bandEnd=bandStart+GRID;
  const shift=dir==='right'||dir==='down'?GRID:-GRID;
  snapshot();
  let moved=0;
  items.forEach(o=>{
   const start=Number(o[axis])||0;
   const crossStart=Number(o[cross])||0;
   const crossSize=Math.max(1,Number(o[horizontal?'h':'w'])||1);
   const center=crossStart+crossSize/2;
   const inBand=center>=bandStart&&center<bandEnd;
   const eligible=dir==='right'||dir==='down'?start>=threshold-1:start<threshold+GRID-1;
   if(inBand&&eligible){o[axis]=start+shift;moved++}
  });
  $('status').textContent=`已插入單格（${({left:'向左',right:'向右',up:'向上',down:'向下'})[dir]}），同列／同行內容已推移`;
 }else{
  const horizontal=type==='column'?true:type==='row'?false:(dir==='left'||dir==='right');
  const axis=horizontal?'x':'y';
  const sizeKey=horizontal?'w':'h';
  const lineCount=mode==='insert'?count:count;
  const delta=lineCount*GRID;
  const range=mode==='delete'?selectedCellRange:null;
  const rangeStart=range?(horizontal?range.x:range.y):null;
  const rangeExtent=range?(horizontal?range.w:range.h):null;
  const available=horizontal?canvasW:canvasH;
  const effectiveCount=range?Math.max(1,Math.min(Math.round(rangeExtent/GRID),Math.floor((available-rangeStart)/GRID))):count;
  const at=mode==='insert'?(horizontal?selectedCell.x+(dir==='right'?GRID:0):selectedCell.y+(dir==='down'?GRID:0)):(range?(horizontal?range.x:range.y):(horizontal?selectedCell.x:selectedCell.y));
  snapshot();
  if(mode==='insert'){
   items.forEach(o=>{
    const start=Number(o[axis])||0;
    const size=Math.max(0,Number(o[sizeKey])||0);
    if(start>=at-1)o[axis]=start+delta;
    else if(start+size>at+1)o[sizeKey]=size+delta;
   });
   $('status').textContent=`已插入 ${count} 個空白${horizontal?'欄':'列'}（${dir==='left'?'左側':dir==='right'?'右側':dir==='up'?'上方':'下方'}）`;
  }else{
   const deleteDelta=effectiveCount*GRID;
   const end=at+deleteDelta;
   const kept=[];
   items.forEach(o=>{
    const start=Number(o[axis])||0;
    const size=Math.max(0,Number(o[sizeKey])||0);
    const finish=start+size;
    if(size===0){if(start>=at&&start<end)return;if(start>=end)o[axis]=start-deleteDelta;kept.push(o);return}
    if(finish<=at+1){kept.push(o);return}
    if(start>=end-1){o[axis]=start-deleteDelta;kept.push(o);return}
    const overlap=Math.max(0,Math.min(finish,end)-Math.max(start,at));
    const newSize=size-overlap;
    if(newSize<=1)return;
    if(start>=at)o[axis]=at;
    o[sizeKey]=newSize;
    kept.push(o);
   });
   items=kept;
   // 刪除畫布格線本身，讓工作區尺寸同步縮小，而不只是移動物件
   if(horizontal)canvasW=Math.max(GRID,canvasW-deleteDelta);
   else canvasH=Math.max(GRID,canvasH-deleteDelta);
   syncCanvasSize();
   $('status').textContent=`已刪除選取範圍的 ${effectiveCount} 個畫布${horizontal?'欄':'列'}；工作區已縮小 ${deleteDelta}px，範圍內物件已移除`; 
  }
 }
 selected=null;selectedIds.clear();selectionAnchorId=null;selectedCellRange=null;
 render();
}
