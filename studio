 }
 if(e.key.startsWith('Arrow')&&tool==='select'){
  const hasObjectSelection=!!selected||selectedIds.size>0;
  if(hasObjectSelection){
   if(mod&&e.shiftKey){
    const handled=keyboardSelectSeatRange(e.key);
    if(handled){e.preventDefault();return}
   }else if(e.shiftKey){
    const handled=keyboardMoveSelection(e.key,true,false);
    if(handled){e.preventDefault();return}
   }else if(!mod){
    const handled=keyboardMoveSelection(e.key,false,false);
    if(handled){e.preventDefault();return}
   }
  }else if(e.shiftKey&&!mod){
   const current=selectedCell||{x:0,y:0};if(!selectedCellRange)selectedCellRange={x:current.x,y:current.y,w:GRID,h:GRID};
   const step=e.key==='ArrowLeft'?{x:-GRID,y:0}:e.key==='ArrowRight'?{x:GRID,y:0}:e.key==='ArrowUp'?{x:0,y:-GRID}:{x:0,y:GRID};
   const nx=Math.max(0,current.x+step.x),ny=Math.max(0,current.y+step.y),x1=Math.min(selectedCellRange.x,nx),y1=Math.min(selectedCellRange.y,ny),x2=Math.max(selectedCellRange.x+selectedCellRange.w,nx+GRID),y2=Math.max(selectedCellRange.y+selectedCellRange.h,ny+GRID);
   selectedCellRange={x:x1,y:y1,w:x2-x1,h:y2-y1};selectedCell={x:nx,y:ny};render();$('status').textContent=`已選取空白格範圍：${selectedCellRange.w/GRID} 欄 × ${selectedCellRange.h/GRID} 列`;e.preventDefault();return;
  }else if(!mod){
   // 沒有選取物件時，方向鍵改為移動畫布格子游標，讓空白格也能用鍵盤定位。
   const step=e.key==='ArrowLeft'?{x:-GRID,y:0}:e.key==='ArrowRight'?{x:GRID,y:0}:e.key==='ArrowUp'?{x:0,y:-GRID}:{x:0,y:GRID};
   const current=selectedCell||{x:0,y:0};
   selectedCell={x:Math.max(0,current.x+step.x),y:Math.max(0,current.y+step.y)};
   ensureCanvasContains(selectedCell.x,selectedCell.y,GRID,GRID);
   hoverCell=null;updateCellMarker();
   $('status').textContent=`目前格子：第 ${selectedCell.x/GRID+1} 欄、第 ${selectedCell.y/GRID+1} 列`;
   e.preventDefault();return;
  }
 }
 if(mod&&key==='c'){copySelection(false);e.preventDefault();return}
 if(mod&&key==='x'){copySelection(true);e.preventDefault();return}
 if(mod&&key==='v'){
  if(clipboard&&clipboard.length){
   snapshot();
   const clones=clipboard.map(o=>{const c=clone(o);c.id=uid();c.x=snap(c.x+GRID);c.y=snap(c.y+GRID);c.name=(c.name||c.type)+' 副本';return c});
   items.push(...clones);setSelection(clones.map(o=>o.id),clones[clones.length-1].id,clones[0].id);
   $('status').textContent=`已貼上 ${clones.length} 個物件`;
  }
  e.preventDefault();return;
 }
 if(mod&&key==='d'){
  const chosen=getSelectedObjects();
  if(chosen.length){
   snapshot();
   const clones=chosen.map(o=>{const c=clone(o);c.id=uid();c.x+=GRID;c.y+=GRID;c.name=(c.name||c.type)+' 副本';return c});
   items.push(...clones);setSelection(clones.map(o=>o.id),clones[clones.length-1].id,clones[0].id);
   $('status').textContent=`已複製 ${clones.length} 個物件`;
  }
  e.preventDefault();return;
 }
 if(mod&&key==='z'&&!e.shiftKey){$('undo').click();e.preventDefault();return}
 if((mod&&key==='y')||(mod&&e.shiftKey&&key==='z')){$('redo').click();e.preventDefault();return}
 if(e.key==='Escape'){selected=null;selectedIds.clear();selectionAnchorId=null;keyboardSeatRange=null;selectedCellRange=null;drag=null;render();$('status').textContent='已取消選取';return}
 if(e.key==='Delete'||e.key==='Backspace'){if(selected||selectedIds.size){$('delete').click();selectionAnchorId=null;e.preventDefault()}}
});

render();syncCanvasSize();
</script>
</body></html>
