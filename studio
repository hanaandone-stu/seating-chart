<!doctype html>
<html lang="zh-Hant">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>座位表繪製工作室</title>
<style>
:root{--bg:#eef1f5;--panel:#fff;--ink:#243447;--muted:#718096;--line:#dce2e9;--blue:#315f86;--accent:#e98a45}
*{box-sizing:border-box}body{margin:0;font-family:system-ui,-apple-system,"Noto Sans TC",sans-serif;color:var(--ink);background:var(--bg)}
header{height:58px;background:#24384d;color:white;display:flex;align-items:center;justify-content:space-between;padding:0 18px;gap:12px}
header strong{font-size:17px}button,select,input{font:inherit}button{border:1px solid var(--line);background:white;color:var(--ink);padding:8px 11px;border-radius:7px;cursor:pointer}button:hover{border-color:#8da9c1;background:#f6f9fc}button.primary{background:var(--blue);color:#fff;border-color:var(--blue)}button.active{background:#e7f0f8;border-color:#6e96b7;color:#214e73}
.top-actions{display:flex;gap:7px;flex-wrap:wrap}.layout{display:grid;grid-template-columns:190px minmax(300px,1fr) 245px;height:calc(100vh - 58px)}
aside{background:var(--panel);padding:14px;overflow:auto}.left{border-right:1px solid var(--line)}.right{border-left:1px solid var(--line)}
h3{font-size:13px;margin:2px 0 10px;color:#516477;letter-spacing:.04em}.tool-grid{display:grid;grid-template-columns:1fr 1fr;gap:7px}.tool{min-height:62px;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:4px;font-size:12px}.tool b{font-size:20px;font-weight:500}.section{border-top:1px solid var(--line);padding-top:14px;margin-top:15px}
main{min-width:0;display:flex;flex-direction:column}.canvasbar{height:46px;display:flex;align-items:center;justify-content:space-between;padding:0 14px;background:#f8fafc;border-bottom:1px solid var(--line);font-size:12px;color:var(--muted);gap:8px}.canvas-wrap{flex:1;min-height:0;overflow:auto;padding:22px;background:#e8edf2}
.canvas-x-scroll{height:16px;flex:none;overflow-x:auto;overflow-y:hidden;background:#e8edf2;border-bottom:1px solid var(--line)}.canvas-x-scroll>div{height:1px}
#canvasSizer{position:relative;flex:none}#stage{position:absolute;top:0;left:0;width:1400px;height:900px;background-color:white;background-image:linear-gradient(#e8edf2 1px,transparent 1px),linear-gradient(90deg,#e8edf2 1px,transparent 1px);background-size:24px 24px;box-shadow:0 2px 12px #1b2b3b18;transform-origin:top left}
#objects{width:100%;height:100%;display:block;overflow:visible;touch-action:none;cursor:crosshair}
.object{cursor:move}.resize-handle{pointer-events:all}.object.selected .shape{stroke:#e8873d!important;stroke-width:3!important}.object text{pointer-events:none;user-select:none}.field{display:flex;flex-direction:column;gap:5px;margin:9px 0;font-size:12px;color:#526477}.field input,.field select{width:100%;padding:8px;border:1px solid var(--line);border-radius:6px;color:var(--ink);background:white}.row2{display:grid;grid-template-columns:1fr 1fr;gap:8px}.hint{font-size:11px;color:var(--muted);line-height:1.5}.wide{width:100%;margin-top:6px}.danger{color:#a33;border-color:#e7caca}.status{font-size:11px;color:#66788a}
@media(max-width:900px){.layout{grid-template-columns:150px minmax(280px,1fr);}.right{display:none}aside{padding:10px}.tool-grid{grid-template-columns:1fr 1fr}}
@media(max-width:600px){header{height:auto;min-height:58px;align-items:flex-start;padding:10px;flex-direction:column}.layout{height:calc(100vh - 100px);grid-template-columns:112px minmax(250px,1fr)}.tool{min-height:55px}.canvas-wrap{padding:10px}}
</style>
</head>
<body>
<header>
  <strong>▦ 座位表繪製工作室</strong>
  <div class="top-actions">
    <button id="undo">↶ 復原</button><button id="redo">↷ 重做</button>
    <button id="save">儲存專案</button><button id="load">載入專案</button>
    <button class="primary" id="export">匯出互動 HTML</button>
  </div>
</header>
<div class="layout">
<aside class="left">
  <h3>繪圖工具</h3>
  <div class="tool-grid">
    <button class="tool active" data-tool="select"><b>↖</b>選取／移動</button>
    <button class="tool" data-tool="seat"><b>▦</b>單一座位</button>
    <button class="tool" data-tool="rect"><b>▭</b>矩形</button>
    <button class="tool" data-tool="roundRect"><b>▢</b>圓角矩形</button>
    <button class="tool" data-tool="circle"><b>◯</b>圓形</button>
    <button class="tool" data-tool="trapezoid"><b>⏢</b>梯形</button>
    <button class="tool" data-tool="diamond"><b>◇</b>菱形</button>
    <button class="tool" data-tool="line"><b>／</b>直線</button>
    <button class="tool" data-tool="text"><b>T</b>文字標籤</button>
    <button class="tool" data-tool="stage"><b>▰</b>舞台</button>
    <button class="tool" data-tool="seatblock"><b>▤</b>座位區</button>
  </div>
  <div class="section">
    <h3>座位批次選取</h3>
    <div class="row2">
      <button id="selectSeatRow" type="button">選取整排</button>
      <button id="selectSeatColumn" type="button">選取整欄</button>
    </div>
    <small class="hint">先點選一個座位，再選取同區域的整排或整欄。</small>
  </div>
  <div class="section">
    <h3>座位區快速建立</h3>
    <label class="field">區域名稱<input id="blockName" value="A區"></label>
    <label class="field">區域名稱顯示位置
      <select id="zoneLabelPosition">
        <option value="top">顯示在座位區上方</option>
        <option value="bottom">顯示在座位區下方</option>
      </select>
    </label>
    <label class="field"><span>數字格式</span><span><input id="padZero" type="checkbox" checked style="width:auto;margin-right:6px">個位數補 0（01、02…）</span></label>
    <div class="row2">
      <label class="field">排數起始<input id="rowStart" type="number" value="1"></label>
      <label class="field">排數結尾<input id="rowEnd" type="number" value="5"></label>
    </div>
    <div class="row2">
      <label class="field">座號起始<input id="seatStart" type="number" value="1"></label>
      <label class="field">座號結尾<input id="seatEnd" type="number" value="10"></label>
    </div>
    <div class="row2">
      <label class="field">水平間距<input id="gapX" type="number" min="24" max="240" step="24" value="24"></label>
      <label class="field">垂直間距<input id="gapY" type="number" min="24" max="240" step="24" value="24"></label>
    </div>
    <p class="hint">排數與座號都採起始、結尾的方式設定，建立時會自動計算總排數與每排座位數。</p>
    <label class="field">座號排列方向
      <select id="numberDirection"><option value="ltr">由左至右</option><option value="rtl">由右至左</option></select>
    </label>
    <label class="field">座號生成方式
      <select id="numberingMode">
        <option value="sequential">連續號碼（1、2、3、4…）</option>
        <option value="odd">連續奇數（1、3、5、7…）</option>
        <option value="even">連續偶數（2、4、6、8…）</option>
      </select>
    </label>
    <button class="primary wide" id="createBlock">＋ 建立座位區</button>
    <p class="hint">建立後每個座位都是獨立物件，可分別修改或移動。</p>
  </div>
  <div class="section">
    <h3>座位區調整</h3>
    <p class="hint">插入／刪除以畫布目前選取的格子為基準，可在沒有座位的空白區操作。刪除會移除游標所在欄／列；重新編號仍需選取座位區。</p>
    <button class="wide" id="renumberBlock">重新編號選取座位區</button>
    <label class="field">插入類型
      <select id="insertType">
        <option value="column">整欄</option>
        <option value="row">整列</option>
        <option value="cell">單格（推移同列／同行內容）</option>
      </select>
    </label>
    <label class="field">插入方向
      <select id="insertDirection">
        <option value="left">向左</option>
        <option value="right" selected>向右</option>
        <option value="up">向上</option>
        <option value="down">向下</option>
      </select>
    </label>
    <label class="field">欄數／列數<input id="insertCount" type="number" min="1" max="30" value="1"></label>
    <button class="wide" id="insertSeats">＋ 插入空白格／欄／列</button>
    <button class="wide danger" id="deleteGridLines">－ 刪除游標所在欄／列</button>
    <p class="hint">Shift＋滑鼠拖曳可框選空白格範圍；或先點一格，再按住 Shift＋方向鍵延伸選取。刪除時依方向刪除選取範圍內的欄或列，完全空白也能刪除。</p>
  </div>
  <div class="section">
    <h3>畫布</h3>
    <button class="wide" id="zoomFit">重設畫布視野</button>
    <div class="row2"><button id="extendRight">向右延伸</button><button id="extendDown">向下延伸</button></div>
    <button class="wide" id="toggleGrid">切換格線</button>
    <div class="section">
      <h3>演唱會與匯出設定</h3>
      <label class="field">演唱會標題<input id="pngTitle" type="text" placeholder="例如：SUPER JUNIOR FANCON [1983]"></label>
      <label class="field">PNG 浮水印<input type="text" value="@hanaandone.stu" readonly></label>
      <label class="field">浮水印透明度<input id="pngWatermarkOpacity" type="range" min="5" max="50" value="16"></label>
      <button class="primary wide" id="exportPng">匯出 PNG 圖檔</button>
    </div>
    <button class="wide" id="clearAll">清空畫布</button>
  </div>
</aside>
<main>
  <div class="canvasbar"><span id="canvasSizeLabel">工作區　1400 × 900｜格線 24 × 24</span><span id="modeLabel">目前工具：選取／移動</span><span class="status" id="status">就緒</span><span class="zoom-controls"><button id="zoomOut" type="button">－</button><span id="zoomLabel">100%</span><button id="zoomIn" type="button">＋</button><button id="zoomFit" type="button">符合視窗</button></span></div>
  <div class="canvas-x-scroll" id="canvasXScroll"><div id="canvasXScrollInner"></div></div>
  <div class="canvas-wrap" id="canvasWrap"><div id="canvasSizer"><div id="stage"><svg id="objects" viewBox="0 0 1400 900" xmlns="http://www.w3.org/2000/svg"></svg></div></div></div>
</main>
<aside class="right">
  <h3>物件屬性</h3>
  <div id="emptyProps" class="hint">選取畫布上的物件，即可在這裡編輯位置、尺寸、文字與顏色。</div>
  <div id="props" hidden>
    <label class="field">物件名稱<input id="pName"></label>
    <div class="row2">
      <label class="field">X<input id="pX" type="number"></label><label class="field">Y<input id="pY" type="number"></label>
    </div>
    <div class="row2">
      <label class="field">寬度<input id="pW" type="number" min="1"></label><label class="field">高度<input id="pH" type="number" min="1"></label>
    </div>
    <label class="field">顯示文字<input id="pText"></label>
    <label class="field" id="textAlignField">文字對齊
      <select id="pTextAlign"><option value="start">靠左對齊</option><option value="middle">置中對齊</option><option value="end">靠右對齊</option></select>
    </label>
    <div class="row2">
      <label class="field">字型大小<input id="pFontSize" type="number" min="6" max="120" value="14"></label>
      <label class="field">字體<select id="pFontFamily">
        <option value="system-ui,-apple-system,'Noto Sans TC',sans-serif">系統預設／思源黑體</option>
        <option value="'Noto Sans TC',sans-serif">Noto Sans TC</option>
        <option value="'Microsoft JhengHei',sans-serif">微軟正黑體</option>
        <option value="Arial,sans-serif">Arial</option>
        <option value="Georgia,serif">Georgia 明體風格</option>
        <option value="'Courier New',monospace">Courier New 等寬字</option>
      </select></label>
    </div>
    <div class="row2">
      <label class="field">填滿顏色<input id="pFill" type="color"></label><label class="field">線條顏色<input id="pStroke" type="color"></label>
    </div>
    <label class="field" id="seatTextColorField" hidden>座位文字顏色<input id="pTextColor" type="color" value="#ffffff"></label>
    <label class="field">填滿色 HEX<input id="pFillHex" type="text" value="#6c9bc5" maxlength="7" placeholder="#RRGGBB"></label>
    <label class="field" id="radiusField" hidden>圓角半徑<input id="pRadius" type="number" min="0" max="200" step="1" value="12"></label>
    <label class="field">旋轉角度<input id="pRotate" type="number" min="-360" max="360"></label>
    <div class="row2"><button id="duplicate">複製物件</button><button id="front">移到最上層</button></div>
    <button class="wide danger" id="delete">刪除物件</button>
    <p class="hint">選取圖案後可拖曳周圍八個控制點調整大小；Shift 拖曳可框選；Ctrl 或 Shift + 點擊可多選；方向鍵可延伸選取範圍。選取單一座位可修改座號字型；選取整個座位區可一次套用所有座位的字型大小與字體。文字物件與區域標題也可個別設定字型。色彩可用選色器或 HEX 色碼輸入。</p>
  </div>
  <div class="section">
    <h3>使用提示</h3>
    <p class="hint">• 選取工具：拖曳物件移動。<br>• 座位會自動吸附至 24 × 24 格線；座位區可自行設定排數與座號的起始、結尾。圓角矩形可在右側調整圓角半徑；梯形與菱形可直接縮放調整比例。<br>• 點選空白格會顯示橘色框線與格子座標；座位區工具會從你點選的格子開始建立。<br>• 畫布可用「向右延伸／向下延伸」增加空間，也會在新增物件超出邊界時自動延伸。<br>• 快捷鍵：方向鍵移動座位選取；Shift+方向鍵延伸範圍；Ctrl+Shift+方向鍵選到同列／同欄最遠座位；Ctrl+A 全選；Ctrl+C/X/V 複製／剪下／貼上；Ctrl+D 複製；Ctrl+Z/Y 復原／重做；Delete 刪除；Esc 取消。<br>• 匯出後的 HTML 可獨立開啟，支援座位點選與區域互動。</p>
  </div>
</aside>
</div>
<input type="file" id="fileInput" accept=".json,application/json" hidden>
<script>
const svg=document.getElementById('objects'),NS='http://www.w3.org/2000/svg';
let items=[],selected=null,selectedIds=new Set(),tool='select',drag=null,resizeDrag=null,selectionDrag=null,selectionAnchorId=null,undoStack=[],redoStack=[],grid=true,clipboard=null;
let canvasW=1400,canvasH=900,hoverCell=null,selectedCell=null,selectedCellRange=null,keyboardSeatRange=null;
// 新增元件沿用最近使用／選取的填滿色與線條色
let lastFillColor='#6c9bc5',lastStrokeColor='#315f86';
const GRID=24;const snap=v=>Math.round(v/GRID)*GRID;const cellAt=p=>({x:Math.floor(p.x/GRID)*GRID,y:Math.floor(p.y/GRID)*GRID});
const $=id=>document.getElementById(id);
const clone=x=>JSON.parse(JSON.stringify(x));
let zoom=1;
function syncCanvasSize(){
 $('stage').style.width=canvasW+'px';$('stage').style.height=canvasH+'px';
 $('stage').style.transform=`scale(${zoom})`;
 $('canvasSizer').style.width=(canvasW*zoom)+'px';$('canvasSizer').style.height=(canvasH*zoom)+'px';
 $('canvasXScrollInner').style.width=(canvasW*zoom+44)+'px';
 svg.setAttribute('viewBox',`0 0 ${canvasW} ${canvasH}`);
 svg.setAttribute('width',canvasW);svg.setAttribute('height',canvasH);
 $('canvasSizeLabel').textContent=`工作區　${canvasW} × ${canvasH}｜格線 24 × 24`;
 $('zoomLabel').textContent=Math.round(zoom*100)+'%';
}
function ensureCanvasContains(x,y,w=0,h=0){
 let changed=false;
 while(x+w+GRID>canvasW){canvasW+=480;changed=true}
 while(y+h+GRID>canvasH){canvasH+=480;changed=true}
 if(changed)syncCanvasSize();
}
function extendCanvas(axis){
 if(axis==='x')canvasW+=480;else canvasH+=480;
 syncCanvasSize();render();
 $('status').textContent=`畫布已延伸至 ${canvasW} × ${canvasH}`;
}
function snapshot(){undoStack.push(JSON.stringify(items));if(undoStack.length>80)undoStack.shift();redoStack=[]}
function uid(){return 'o'+Math.random().toString(36).slice(2,10)}
function setTool(t){tool=t;document.querySelectorAll('[data-tool]').forEach(b=>b.classList.toggle('active',b.dataset.tool===t));$('modeLabel').textContent='目前工具：'+({select:'選取／移動',seat:'單一座位',rect:'矩形',roundRect:'圓角矩形',circle:'圓形',trapezoid:'梯形',diamond:'菱形',line:'直線',text:'文字標籤',stage:'舞台',seatblock:'座位區'}[t])}
document.querySelectorAll('[data-tool]').forEach(b=>b.onclick=()=>setTool(b.dataset.tool));
function add(type,x,y,w,h,text,fill='#6c9bc5',stroke='#315f86',extra={}){ensureCanvasContains(x,y,w,h);const o={id:uid(),type,x,y,w,h,text,fill,stroke,rotate:0,name:text||type,...extra};items.push(o);selected=o.id;selectedIds=new Set([o.id]);render();return o}
function el(tag,attrs={}){const n=document.createElementNS(NS,tag);Object.entries(attrs).forEach(([k,v])=>n.setAttribute(k,v));return n}
function render(){
 syncCanvasSize();svg.innerHTML='';
 [...items].sort((a,b)=>{
  // 圖層順序：區域外框在底層，排數文字在最上層，避免被相鄰座位圖形遮住而誤選座位。
  const layer=o=>o.type==='blockBounds'?0:o.type==='rowlabel'?2:1;
  return layer(a)-layer(b);
 }).forEach(o=>{
  const g=el('g',{class:'object'+(selectedIds.has(o.id)||o.id===selected?' selected':''),transform:`translate(${o.x} ${o.y}) rotate(${o.rotate||0} ${o.w/2} ${o.h/2})`,'data-id':o.id});
  let shape;
  if(o.type==='blockBounds'){shape=el('rect',{x:0,y:0,width:o.w,height:o.h,fill:'transparent',stroke:o.stroke,'stroke-width':2,'stroke-dasharray':'5 3',class:'shape'});g.append(shape)}
  else if(o.type==='rowlabel'){
   // 排數文字只保留自身範圍的透明命中區，不套用物件外框樣式。
   // 避免選取框與八個縮放控制點伸入第一欄座位，干擾座位點選。
   shape=el('rect',{x:-o.w,y:0,width:o.w,height:o.h,fill:'transparent',stroke:'none',class:'rowlabel-hit-area','pointer-events':'all'});
   g.append(shape);
   const align=o.textAlign||'end',textX=align==='start'?-o.w:align==='middle'?-o.w/2:0;
   const t=el('text',{x:textX,y:Math.max(17,o.h*.72),'font-size':o.fontSize||14,'font-family':o.fontFamily||undefined,fill:o.fill,'font-weight':'700','text-anchor':align==='start'?'start':align==='middle'?'middle':'end','pointer-events':'all'});
   t.textContent=o.text;g.append(t);
   // 被選取的排數文字仍顯示橘色實線框；框線不攔截滑鼠，也不產生縮放控制點。
   if(selectedIds.has(o.id)||o.id===selected){
    g.append(el('rect',{x:-o.w,y:0,width:o.w,height:o.h,fill:'none',stroke:'#e8873d','stroke-width':1.8,class:'rowlabel-selection-outline','pointer-events':'none'}));
   }
  }
  else if(o.type==='seat'){shape=el('rect',{x:0,y:0,width:o.w,height:o.h,rx:4,fill:o.fill,stroke:o.stroke,'stroke-width':1.3,class:'shape'});g.append(shape);const t=el('text',{x:o.w/2,y:o.h/2+4,'text-anchor':'middle','font-size':o.fontSize||Math.min(12,o.h*.48),'font-family':o.fontFamily||undefined,fill:o.textColor||'#ffffff','font-weight':'600'});t.textContent=o.text;g.append(t)}
  else if(o.type==='line'){shape=el('line',{x1:0,y1:0,x2:o.w,y2:o.h,stroke:o.stroke,'stroke-width':3,class:'shape'});g.append(shape)}
  else if(o.type==='roundRect'){shape=el('rect',{x:0,y:0,width:o.w,height:o.h,rx:Math.max(0,Math.min(Number(o.radius??12),Math.min(o.w,o.h)/2)),fill:o.fill,stroke:o.stroke,'stroke-width':2,class:'shape'});g.append(shape);if(o.text){const t=el('text',{x:o.w/2,y:o.h/2+5,'text-anchor':'middle','font-size':o.fontSize||18,'font-family':o.fontFamily||undefined,fill:'#fff','font-weight':'700'});t.textContent=o.text;g.append(t)}}
   else if(o.type==='circle'){shape=el('ellipse',{cx:o.w/2,cy:o.h/2,rx:o.w/2,ry:o.h/2,fill:o.fill,stroke:o.stroke,'stroke-width':2,class:'shape'});g.append(shape);if(o.text){const t=el('text',{x:o.w/2,y:o.h/2+5,'text-anchor':'middle','font-size':o.fontSize||18,'font-family':o.fontFamily||undefined,fill:'#fff','font-weight':'700'});t.textContent=o.text;g.append(t)}}
