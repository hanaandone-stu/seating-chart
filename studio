function renumberGroup(groupId,record=true){
 const group=items.filter(o=>o.groupId===groupId);
 const seats=group.filter(o=>o.type==='seat');
 const labels=group.filter(o=>o.type==='rowlabel');
 if(!seats.length){alert('找不到這個座位區的座位。');return false}
 const rowStart=Number($('rowStart').value);
 const seatStart=Number($('seatStart').value);
 if(!Number.isInteger(rowStart)||!Number.isInteger(seatStart)){alert('排數與座號起始值必須是整數。');return false}
 const mode=$('numberingMode').value;
 const rowYs=[...new Set(seats.map(o=>o.y))].sort((a,b)=>a-b);
 const seatXs=[...new Set(seats.map(o=>o.x))].sort((a,b)=>a-b);
 let nums=Array.from({length:seatXs.length},(_,i)=>seatStart+i);
 if(mode==='odd')nums=nums.filter(n=>Math.abs(n%2)===1);
 if(mode==='even')nums=nums.filter(n=>n%2===0);
 if(nums.length<seatXs.length){alert('目前座號起始值產生的號碼不足以填滿每一排，請調整座號起始值或生成方式。');return false}
 if($('numberDirection').value==='rtl')nums.reverse();
 if(record)snapshot();
 rowYs.forEach((y,r)=>{
  const rowNo=rowStart+r;
  const rowLabel=labels.find(o=>Math.abs(o.y-y)<2);
  if(rowLabel){rowLabel.text=formatNumber(rowNo);rowLabel.name=`第 ${rowNo} 排`}
  seats.filter(o=>Math.abs(o.y-y)<2).sort((a,b)=>a.x-b.x).forEach((seat,c)=>{
   seat.text=formatNumber(nums[c]);
   seat.name=`${rowNo}排 ${seat.text}號`;
  });
 });
 render();
 $('status').textContent=`已重新編號：${rowYs.length} 排 × ${seatXs.length} 個座位`;
 return true;
}
